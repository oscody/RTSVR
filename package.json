{
  "name": "RTSVR",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/with-supported-node.sh iwsdk dev up --open --foreground",
    "dev:runtime": "bash scripts/with-supported-node.sh vite",
    "dev:down": "bash scripts/with-supported-node.sh iwsdk dev down",
    "dev:status": "bash scripts/with-supported-node.sh iwsdk dev status",
    "reference:status": "bash scripts/with-supported-node.sh iwsdk reference status",
    "reference:warmup": "bash scripts/with-supported-node.sh iwsdk reference warmup",
    "test": "bash scripts/with-supported-node.sh node --experimental-strip-types --test tests/*.test.ts",
    "build": "bash scripts/with-supported-node.sh vite build",
    "preview": "bash scripts/with-supported-node.sh vite preview"
  },
  "dependencies": {
    "@iwsdk/core": "0.4.2",
    "three": "npm:super-three@0.181.0"
  },
  "devDependencies": {
    "@iwsdk/cli": "0.4.2",
    "@iwsdk/reference": "0.4.2",
    "@iwsdk/vite-plugin-dev": "0.4.2",
    "@iwsdk/vite-plugin-uikitml": "0.4.2",
    "@meta-quest/hzdb": "^1.0.0",
    "@types/three": "*",
    "typescript": "^5.5.0",
    "vite": "^7.1.4",
    "vite-plugin-mkcert": "^1.17.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}
