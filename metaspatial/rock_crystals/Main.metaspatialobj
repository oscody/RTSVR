scene: docref:Main.scene
entities:
  com.meta.models.AssetFolder:
  - components:
      com.meta.components.AssetFolder:
        assets:
        - ref:crystal
        - ref:rock
        - ref:rockTrack
        - ref:Mesh rock_crystals
      com.meta.components.Name:
        name: rock_crystals
  com.meta.models.AssetRoot:
  - components:
      com.meta.components.AssetMetadata: {}
      com.meta.components.AssetRoot:
        defaultScene: ref:Scene
        scenes:
        - ref:Scene
  com.meta.models.Geometry:
  - components:
      com.meta.components.Geometry:
        data: binary/Geometry2.bin
        mode: Triangles
    tag: Geometry2
  - components:
      com.meta.components.Geometry:
        data: binary/Geometry1.bin
        mode: Triangles
    tag: Geometry1
  - components:
      com.meta.components.Geometry:
        data: binary/Geometry.bin
        mode: Triangles
    tag: Geometry
  com.meta.models.Material:
  - uri: docref:materials/rockTrack.metaspatialmaterial
    tag: rockTrack
  - uri: docref:materials/rock.metaspatialmaterial
    tag: rock
  - uri: docref:materials/crystal.metaspatialmaterial
    tag: crystal
  com.meta.models.Mesh:
  - components:
      com.meta.components.Mesh:
        morphTargetNames: []
        morphTargetWeights: []
        primitives:
        - ref:Primitive1
        - ref:Primitive
        - ref:Primitive2
      com.meta.components.Name:
        name: Mesh rock_crystals
      com.meta.components.PointerNodeInverseComponent: {}
    tag: Mesh rock_crystals
  com.meta.models.Primitive:
  - components:
      com.meta.components.Primitive:
        geometry: ref:Geometry1
        material: ref:crystal
    tag: Primitive2
  - components:
      com.meta.components.Primitive:
        geometry: ref:Geometry
        material: ref:rockTrack
    tag: Primitive1
  - components:
      com.meta.components.Primitive:
        geometry: ref:Geometry2
        material: ref:rock
    tag: Primitive
metadata:
  version: 1.35