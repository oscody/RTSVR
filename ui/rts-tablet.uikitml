<style>
  .tablet {
    flex-direction: column;
    width: 600px;
    height: 460px;
    padding: 16px;
    background-color: #dfe8ee;
    border-width: 10px;
    border-color: #536a7d;
    border-radius: 8px;
    color: #15212a;
  }

  .top-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 548px;
    height: 34px;
  }

  .title {
    width: 178px;
    height: 30px;
    color: #15212a;
    font-size: 24px;
    font-weight: 700;
  }

  .level-chip {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 86px;
    height: 28px;
    background-color: #ecf7fb;
    border-width: 1px;
    border-color: #74a7bb;
    border-radius: 5px;
  }

  .level-label {
    height: 22px;
    color: #365466;
    font-size: 13px;
    font-weight: 700;
    margin-right: 5px;
  }

  .level-value {
    height: 24px;
    color: #0e7490;
    font-size: 20px;
    font-weight: 800;
  }

  .balance {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    width: 210px;
    height: 30px;
  }

  .balance-icon {
    width: 19px;
    height: 19px;
    color: #0e7490;
    margin-right: 7px;
  }

  .balance-label {
    height: 24px;
    color: #244152;
    font-size: 15px;
  }

  .balance-value {
    width: 72px;
    height: 26px;
    color: #0e7490;
    font-size: 21px;
    font-weight: 700;
    text-align: right;
  }

  .wave-banner {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 548px;
    height: 28px;
    margin-top: 6px;
    background-color: #fef3c7;
    border-width: 1px;
    border-color: #d97706;
    border-radius: 6px;
  }

  .wave-banner-label {
    color: #92400e;
    font-size: 14px;
    font-weight: 700;
    margin-right: 6px;
  }

  .wave-banner-value {
    color: #92400e;
    font-size: 16px;
    font-weight: 800;
  }

  .session-actions {
    flex-direction: row;
    justify-content: space-between;
    width: 548px;
    height: 34px;
    margin-top: 8px;
  }

  .restart-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 268px;
    min-width: 268px;
    height: 34px;
    padding: 0px;
    background-color: #176b55;
    border-width: 1px;
    border-color: #105446;
    border-radius: 5px;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
  }

  .restart-button:hover {
    background-color: #105446;
  }

  .exit-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 268px;
    min-width: 268px;
    height: 34px;
    padding: 0px;
    background-color: #b42318;
    border-width: 1px;
    border-color: #7a271a;
    border-radius: 5px;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
  }

  .exit-button:hover {
    background-color: #912018;
  }

  .restart-icon {
    width: 15px;
    height: 15px;
    color: #ffffff;
    margin-right: 5px;
  }

  .exit-icon {
    width: 15px;
    height: 15px;
    color: #ffffff;
    margin-right: 5px;
  }

  .tabs {
    flex-direction: row;
    justify-content: space-between;
    width: 548px;
    height: 42px;
    margin-top: 8px;
  }

  .tab {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 104px;
    min-width: 104px;
    height: 38px;
    padding: 0px;
    background-color: #c8d4dc;
    border-width: 1px;
    border-color: #8497a5;
    border-radius: 5px;
    color: #1d3442;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
  }

  .tab:hover {
    background-color: #b4c7d2;
  }

  .tab-icon {
    width: 15px;
    height: 15px;
    color: #1d3442;
    margin-right: 4px;
  }

  .view {
    flex-direction: column;
    width: 548px;
    height: 274px;
    margin-top: 8px;
  }

  .section-title {
    width: 548px;
    height: 27px;
    color: #15212a;
    font-size: 20px;
    font-weight: 700;
  }

  .stats-row {
    flex-direction: row;
    justify-content: space-between;
    width: 548px;
    height: 94px;
    margin-top: 10px;
  }

  .stat {
    flex-direction: column;
    justify-content: center;
    width: 128px;
    height: 88px;
    padding: 10px;
    background-color: #f7fafc;
    border-width: 1px;
    border-color: #afbec8;
    border-radius: 5px;
  }

  .stat-label {
    width: 108px;
    height: 18px;
    color: #607482;
    font-size: 12px;
  }

  .stat-value {
    width: 108px;
    height: 36px;
    color: #172a36;
    font-size: 28px;
    font-weight: 700;
  }

  .builder {
    width: 548px;
    height: 22px;
    color: #365466;
    font-size: 14px;
  }

  .card-row {
    flex-direction: row;
    justify-content: space-between;
    width: 548px;
    height: 98px;
    margin-top: 6px;
  }

  .build-card {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 174px;
    min-width: 174px;
    height: 94px;
    padding: 6px;
    background-color: #f7fafc;
    border-width: 1px;
    border-color: #9aa8b4;
    border-radius: 5px;
    cursor: pointer;
  }

  .build-card:hover {
    background-color: #e8f4f8;
  }

  .locked-card {
    background-color: #cbd3d8;
    border-color: #a7b0b6;
    color: #65737c;
  }

  /* Width and height deliberately absent — they are set from code.
     UIKit's <img> defaults to keepAspectRatio:true, which derives one axis from
     the picture's own shape, so a box declared here can disagree with the image
     and the taller sources overflow their card (astronautA is 40x72 and rendered
     137px tall in a 70px box). `fitThumbnail` in tabletThumbnails.ts computes a
     size that is consistent with each source's aspect; leaving the class silent
     on size means there is nothing for it to conflict with. */
  .card-image {
    border-radius: 3px;
  }

  .card-name {
    width: 158px;
    height: 19px;
    color: #172a36;
    font-size: 13px;
    font-weight: 700;
    text-align: center;
  }

  .card-cost {
    width: 158px;
    height: 17px;
    color: #0e7490;
    font-size: 12px;
    text-align: center;
  }

  /*
    Build/craft tile stats: spawn time, attack, health.

    10px and muted so it reads as reference rather than competing with the name
    and cost. The build card had 4px of slack in its fixed 94px, so the
    thumbnail shrank 42px -> 26px to pay for this line — see
    TABLET_BUILD_THUMB_HEIGHT. Craft cards had 27px spare and needed nothing.
  */
  .card-stats {
    /*
      162px, not the 158px the name and cost use: the build card is 174px with
      6px padding, so 162px is the full content width and the widest line
      (`Build: 3s  Attack: 18  Hp: 240`, 30 chars) needs every pixel of it.
      Overflow here is silent, so the margin is the safety.
    */
    width: 162px;
    height: 15px;
    color: #64748b;
    font-size: 10px;
    text-align: center;
  }

  .locked-label {
    width: 150px;
    height: 24px;
    color: #667680;
    font-size: 15px;
    font-weight: 700;
    text-align: center;
  }

  .craft-source {
    width: 548px;
    height: 22px;
    color: #365466;
    font-size: 14px;
    font-weight: 700;
  }

  .craft-row {
    flex-direction: row;
    justify-content: space-between;
    width: 548px;
    height: 98px;
    margin-top: 6px;
  }

  .craft-card {
    flex-direction: row;
    align-items: center;
    width: 268px;
    min-width: 268px;
    height: 94px;
    padding: 7px;
    background-color: #f7fafc;
    border-width: 1px;
    border-color: #9aa8b4;
    border-radius: 5px;
    cursor: pointer;
  }

  .craft-card:hover {
    background-color: #e8f4f8;
  }

  /* Width and height deliberately absent — they are set from code.
     UIKit's <img> defaults to keepAspectRatio:true, which derives one axis from
     the picture's own shape, so a box declared here can disagree with the image
     and the taller sources overflow their card (astronautA is 40x72 and rendered
     137px tall in a 70px box). `fitThumbnail` in tabletThumbnails.ts computes a
     size that is consistent with each source's aspect; leaving the class silent
     on size means there is nothing for it to conflict with. */
  .craft-image {
    border-radius: 3px;
  }

  .craft-copy {
    flex-direction: column;
    justify-content: center;
    width: 168px;
    height: 70px;
    margin-left: 8px;
  }

  .craft-name {
    width: 168px;
    height: 23px;
    color: #172a36;
    font-size: 15px;
    font-weight: 700;
  }

  .craft-cost {
    width: 168px;
    height: 20px;
    color: #0e7490;
    font-size: 13px;
  }

  .craft-action-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 548px;
    height: 46px;
    margin-top: 6px;
  }

  .craft-page {
    width: 88px;
    height: 22px;
    color: #607482;
    font-size: 13px;
    text-align: center;
  }

  .craft-pagination {
    flex-direction: row;
    align-items: center;
    width: 168px;
    height: 40px;
  }

  .page-button {
    align-items: center;
    justify-content: center;
    width: 34px;
    min-width: 34px;
    height: 34px;
    padding: 0px;
    background-color: #c8d4dc;
    border-width: 1px;
    border-color: #8497a5;
    border-radius: 5px;
    cursor: pointer;
  }

  .page-icon {
    width: 18px;
    height: 18px;
    color: #1d3442;
  }

  .craft-action {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 320px;
    min-width: 320px;
    height: 40px;
    padding: 0px;
    padding-left: 10px;
    padding-right: 10px;
    background-color: #176b55;
    border-width: 1px;
    border-color: #105446;
    border-radius: 5px;
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
  }

  .craft-action:hover {
    background-color: #105446;
  }

  /* Crafts action row carries pagination as well, so its cancel and produce
     buttons are narrower than the Build tab's: 168 + 148 + 224 = 540 of 548.
     Full-width versions would total 664 and overflow by 116px, which is what
     crushed the pagination the last time three items shared this row. */
  .craft-cancel {
    width: 148px;
    min-width: 148px;
  }

  .craft-action-narrow {
    width: 224px;
    min-width: 224px;
  }

  .craft-action-icon {
    width: 17px;
    height: 17px;
    color: #ffffff;
    margin-right: 7px;
  }

  .units-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 548px;
    height: 26px;
  }

  .unit-filter {
    width: 350px;
    height: 23px;
    color: #244152;
    font-size: 15px;
    font-weight: 700;
  }

  .unit-selected {
    width: 180px;
    height: 23px;
    color: #0e7490;
    font-size: 14px;
    font-weight: 700;
    text-align: right;
  }

  .unit-row {
    flex-direction: row;
    justify-content: space-between;
    width: 548px;
    height: 98px;
    margin-top: 5px;
  }

  .unit-card {
    flex-direction: row;
    align-items: center;
    width: 268px;
    min-width: 268px;
    height: 94px;
    padding: 7px;
    background-color: #f7fafc;
    border-width: 1px;
    border-color: #9aa8b4;
    border-radius: 5px;
    cursor: pointer;
  }

  .unit-card:hover {
    background-color: #e8f4f8;
  }

  /* Width and height deliberately absent — they are set from code.
     UIKit's <img> defaults to keepAspectRatio:true, which derives one axis from
     the picture's own shape, so a box declared here can disagree with the image
     and the taller sources overflow their card (astronautA is 40x72 and rendered
     137px tall in a 70px box). `fitThumbnail` in tabletThumbnails.ts computes a
     size that is consistent with each source's aspect; leaving the class silent
     on size means there is nothing for it to conflict with. */
  .unit-image {
    border-radius: 3px;
  }

  .unit-copy {
    flex-direction: column;
    justify-content: center;
    width: 168px;
    height: 70px;
    margin-left: 8px;
  }

  .unit-name {
    width: 168px;
    height: 24px;
    color: #172a36;
    font-size: 15px;
    font-weight: 700;
  }

  .unit-meta {
    width: 168px;
    height: 20px;
    color: #607482;
    font-size: 12px;
  }

  .unit-action-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 548px;
    height: 42px;
    margin-top: 5px;
  }

  .unit-clear {
    align-items: center;
    justify-content: center;
    width: 176px;
    min-width: 176px;
    height: 34px;
    padding: 0px;
    background-color: #c8d4dc;
    border-width: 1px;
    border-color: #8497a5;
    border-radius: 5px;
    color: #1d3442;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
  }

  .status {
    width: 548px;
    height: 25px;
    color: #176b55;
    font-size: 14px;
    font-weight: 700;
    text-align: center;
    margin-top: 5px;
  }

  /* The one debug affordance reachable inside the headset — the CLI is not.
     Lives in the tab, not the split-out settings panel, so it does not reopen
     that work. Costs one element in the always-loaded tablet document. */
  .settings-dump {
    width: 280px;
    height: 30px;
    margin-top: 10px;
    align-items: center;
    justify-content: center;
    background-color: #c8d4dc;
    border-width: 1px;
    border-color: #8497a5;
    border-radius: 5px;
    color: #1d3442;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
  }

  .settings-dump:hover {
    background-color: #b4c7d2;
  }

  .settings-hint {
    width: 548px;
    height: 24px;
    color: #244152;
    font-size: 13px;
  }
  .settings-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 266px;
    height: 25px;
    margin-top: 2px;
    padding-left: 6px;
    padding-right: 6px;
    background-color: #f7fafc;
    border-width: 1px;
    border-color: #afbec8;
    border-radius: 5px;
  }

  .settings-label {
    width: 136px;
    height: 18px;
    color: #244152;
    font-size: 11px;
    font-weight: 700;
  }

  .settings-columns {
    flex-direction: row;
    width: 548px;
    height: 244px;
    justify-content: space-between;
    margin-top: 1px;
  }

  .settings-column {
    flex-direction: column;
    width: 268px;
    height: 244px;
  }

  .settings-controls {
    flex-direction: row;
    align-items: center;
  }

  .settings-value {
    width: 48px;
    height: 20px;
    color: #0e7490;
    font-size: 13px;
    font-weight: 800;
    text-align: center;
  }

  .settings-button {
    align-items: center;
    justify-content: center;
    width: 22px;
    min-width: 22px;
    height: 22px;
    padding: 0px;
    background-color: #c8d4dc;
    border-width: 1px;
    border-color: #8497a5;
    border-radius: 5px;
    cursor: pointer;
  }

  .settings-button:hover {
    background-color: #b4c7d2;
  }

  .settings-button-icon {
    width: 12px;
    height: 12px;
    color: #1d3442;
  }



  /* One span per profiler row (frameProfiler.ts builds them). UIKit ignores
     "\n" inside a text element, so a single span word-wraps the whole block and
     splits labels mid-row; separate spans are what actually forces line breaks.
     The font is sized so each row fits on one line at this width. */
</style>
<Panel class="tablet">
  <div class="top-row">
    <span class="title">RTS-VR</span>
    <div id="level-chip" class="level-chip">
      <span class="level-label">Level</span>
      <span id="current-level" class="level-value">1</span>
    </div>
    <div class="balance">
      <GemIcon class="balance-icon"></GemIcon>
      <span class="balance-label">Crystals</span>
      <span id="crystal-balance" class="balance-value">0</span>
    </div>
  </div>
  <div class="session-actions">
    <button id="restart-game" class="restart-button"><RotateCcwIcon class="restart-icon"></RotateCcwIcon><span>Restart</span></button>
    <button id="exit-vr" class="exit-button"><LogOutIcon class="exit-icon"></LogOutIcon><span>Exit VR</span></button>
  </div>
  <div id="wave-banner" class="wave-banner">
    <span id="wave-banner-label" class="wave-banner-label">Wave 1 incoming in</span>
    <span id="wave-countdown" class="wave-banner-value">3</span>
  </div>
  <div class="tabs">
    <button id="tab-overview" class="tab"><ChartBarIcon class="tab-icon"></ChartBarIcon><span>Overview</span></button>
    <button id="tab-build" class="tab"><HammerIcon class="tab-icon"></HammerIcon><span>Build</span></button>
    <button id="tab-crafts" class="tab"><RocketIcon class="tab-icon"></RocketIcon><span>Crafts</span></button>
    <button id="tab-units" class="tab"><UsersIcon class="tab-icon"></UsersIcon><span>Units</span></button>
    <button id="tab-settings" class="tab"><SlidersHorizontalIcon class="tab-icon"></SlidersHorizontalIcon><span>Settings</span></button>
  </div>
  <!-- The profiler / FPS readout used to live here, OUTSIDE every view, which is
       exactly why it painted on all five tabs. Removed 2026-08-20: it was a
       developer readout in 8px type that the player cannot read, laid out every
       second by the system that owns 96% of the worst frames. The same numbers
       still go to the console once per second - see frameProfiler.ts. -->
  <div id="overview-view" class="view">
    <span class="section-title">Economy and forces</span>
    <div class="stats-row">
      <div class="stat"><span class="stat-label">Available</span><span id="overview-crystals" class="stat-value">0</span></div>
      <div class="stat"><span class="stat-label">Total mined</span><span id="overview-mined" class="stat-value">0</span></div>
      <div class="stat"><span class="stat-label">Buildings</span><span id="overview-buildings" class="stat-value">0</span></div>
      <div class="stat"><span class="stat-label">Crafts</span><span id="overview-crafts" class="stat-value">0</span></div>
    </div>
    <div class="stats-row">
      <div class="stat"><span class="stat-label">Astronauts</span><span id="overview-astronauts" class="stat-value">0</span></div>
      <div class="stat"><span class="stat-label">Enemies alive</span><span id="overview-enemies" class="stat-value">0</span></div>
      <div class="stat"><span class="stat-label">Enemies killed</span><span id="overview-kills" class="stat-value">0</span></div>
      <div class="stat"><span class="stat-label">Total units</span><span id="overview-units" class="stat-value">0</span></div>
    </div>
  </div>
  <div id="build-view" class="view" style="display: none;">
    <span id="builder-label" class="builder">Select an astronaut</span>
    <div class="card-row">
      <button id="build-hangar" class="build-card" style="display: none;"><img id="build-image-hangar" class="card-image" src="./images/hangar_largeA.png"></img><span class="card-name">Hangar</span><span id="build-cost-hangar" class="card-cost">- crystals</span><span id="build-stats-hangar" class="card-stats">Build: -  Attack: -  Hp: -</span></button>
      <button id="build-factory" class="build-card" style="display: none;"><img id="build-image-factory" class="card-image" src="./images/kenney_style_aircraft_factory_preview.png"></img><span class="card-name">Aircraft Factory</span><span id="build-cost-factory" class="card-cost">- crystals</span><span id="build-stats-factory" class="card-stats">Build: -  Attack: -  Hp: -</span></button>
      <button id="build-turret" class="build-card"><img id="build-image-turret" class="card-image" src="./images/turret_single.png"></img><span class="card-name">Turret</span><span id="build-cost-turret" class="card-cost">- crystals</span><span id="build-stats-turret" class="card-stats">Build: -  Attack: -  Hp: -</span></button>
    </div>
    <div class="card-row">
      <button id="build-astronaut" class="build-card"><img id="build-image-astronaut" class="card-image" src="./images/astronautA.png"></img><span class="card-name">Astronaut</span><span id="build-cost-astronaut" class="card-cost">- crystals</span><span id="build-stats-astronaut" class="card-stats">Build: -  Attack: -  Hp: -</span></button>
      <button id="build-relay" class="build-card locked-card" style="display: none;"><span class="locked-label">Relay - Locked</span></button>
      <button id="build-shield" class="build-card locked-card" style="display: none;"><span class="locked-label">Shield - Locked</span></button>
      <button id="build-lab" class="build-card locked-card" style="display: none;"><span class="locked-label">Research Lab - Locked</span></button>
    </div>
    <div class="craft-action-row">
      <button id="build-cancel" class="unit-clear"><span id="build-cancel-label">Cancel site</span></button>
      <button id="build-produce" class="craft-action"><HammerIcon class="craft-action-icon"></HammerIcon><span id="build-action-label">Choose a building</span></button>
    </div>
  </div>
  <div id="crafts-view" class="view" style="display: none;">
    <span id="craft-source-label" class="craft-source">Pick a craft, then pick a tile</span>
    <div class="craft-row">
      <button id="craft-card-0" class="craft-card"><img id="craft-image-0" class="craft-image" src="./images/craft_miner.png"></img><div class="craft-copy"><span id="craft-name-0" class="craft-name">Cargo Craft</span><span id="craft-cost-0" class="craft-cost">- crystals</span><span id="craft-stats-0" class="card-stats">Build: -  Attack: -  Hp: -</span></div></button>
      <button id="craft-card-1" class="craft-card"><img id="craft-image-1" class="craft-image" src="./images/craft_miner.png"></img><div class="craft-copy"><span id="craft-name-1" class="craft-name">Mining Craft</span><span id="craft-cost-1" class="craft-cost">- crystals</span><span id="craft-stats-1" class="card-stats">Build: -  Attack: -  Hp: -</span></div></button>
    </div>
    <div class="craft-row">
      <button id="craft-card-2" class="craft-card"><img id="craft-image-2" class="craft-image" src="./images/craft_racer.png"></img><div class="craft-copy"><span id="craft-name-2" class="craft-name">Fighter Craft</span><span id="craft-cost-2" class="craft-cost">- crystals</span><span id="craft-stats-2" class="card-stats">Build: -  Attack: -  Hp: -</span></div></button>
      <button id="craft-card-3" class="craft-card"><img id="craft-image-3" class="craft-image" src="./images/rover.png"></img><div class="craft-copy"><span id="craft-name-3" class="craft-name">Rover</span><span id="craft-cost-3" class="craft-cost">- crystals</span><span id="craft-stats-3" class="card-stats">Build: -  Attack: -  Hp: -</span></div></button>
    </div>
    <div class="craft-action-row">
      <div class="craft-pagination"><button id="craft-prev" class="page-button"><ChevronLeftIcon class="page-icon"></ChevronLeftIcon></button><span id="craft-page-label" class="craft-page">Page 1 / 1</span><button id="craft-next" class="page-button"><ChevronRightIcon class="page-icon"></ChevronRightIcon></button></div>
      <button id="craft-cancel" class="unit-clear craft-cancel"><span id="craft-cancel-label">Cancel</span></button>
      <button id="craft-produce" class="craft-action craft-action-narrow"><RocketIcon class="craft-action-icon"></RocketIcon><span id="craft-action-label">Choose a craft</span></button>
    </div>
  </div>
  <div id="units-view" class="view" style="display: none;">
    <div class="units-header"><span id="unit-filter-label" class="unit-filter">All units</span><span id="unit-selected-label" class="unit-selected">0 selected</span></div>
    <div class="unit-row">
      <button id="unit-card-0" class="unit-card"><img id="unit-image-0" class="unit-image" src="./images/rover.png"></img><div class="unit-copy"><span id="unit-name-0" class="unit-name">Empty</span><span id="unit-meta-0" class="unit-meta">No unit in this slot</span></div></button>
      <button id="unit-card-1" class="unit-card"><img id="unit-image-1" class="unit-image" src="./images/rover.png"></img><div class="unit-copy"><span id="unit-name-1" class="unit-name">Locked</span><span id="unit-meta-1" class="unit-meta">Future reinforcement</span></div></button>
    </div>
    <div class="unit-row">
      <button id="unit-card-2" class="unit-card"><img id="unit-image-2" class="unit-image" src="./images/rover.png"></img><div class="unit-copy"><span id="unit-name-2" class="unit-name">Empty</span><span id="unit-meta-2" class="unit-meta">No unit in this slot</span></div></button>
      <button id="unit-card-3" class="unit-card"><img id="unit-image-3" class="unit-image" src="./images/rover.png"></img><div class="unit-copy"><span id="unit-name-3" class="unit-name">Locked</span><span id="unit-meta-3" class="unit-meta">Future reinforcement</span></div></button>
    </div>
    <div class="unit-action-row"><div class="craft-pagination"><button id="unit-prev" class="page-button"><ChevronLeftIcon class="page-icon"></ChevronLeftIcon></button><span id="unit-page-label" class="craft-page">Page 1 / 1</span><button id="unit-next" class="page-button"><ChevronRightIcon class="page-icon"></ChevronRightIcon></button></div><button id="unit-destroy" class="unit-clear"><span id="unit-destroy-label">Destroy</span></button><button id="unit-clear" class="unit-clear"><span>Clear selection</span></button></div>
  </div>
  <div id="settings-view" class="view" style="display: none;">
    <span class="section-title">Playtesting settings</span>
    <!-- The 19 setting rows moved to ui/rts-settings.uikitml, which is created
         only while this tab is open and destroyed when it closes.
         They were 158 of this document's 328 elements, and PanelUISystem ticks
         every configured panel each frame regardless of visibility, so hiding
         them here saved nothing. Removing them does. -->
    <span class="settings-hint">Controls open in their own panel below the tablet.</span>
    <button id="dump-trace" class="settings-dump">DUMP TRACE TO CONSOLE</button>
  </div>
  <span id="tablet-status" class="status">Select an astronaut to build</span>
</Panel>
